# JWT_SECRET: Required. Auth fails closed if this is unset — there is no
# hardcoded fallback. Use a long random value in every environment.
JWT_SECRET="change-me-to-a-long-random-secret"

# -----------------------------------------------------------------------------
# Postgres (Epic 0 — data durability)
# Cloud Run is stateless. node:sqlite at data/lumera.db is discarded on every
# deploy, scale-to-zero, and extra instance. Production FAIL-FASTS without a
# real DATABASE_URL (same boot path as JWT_SECRET). Do not silently use sqlite
# on Cloud Run.
#
# Local / tests: leave DATABASE_URL unset → sqlite at data/lumera.db.
# Production / Cloud Run unix socket (Cloud SQL Auth Proxy mount):
#   DATABASE_URL=postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:asia-south1:INSTANCE
# INSTANCE_CONNECTION_NAME is PROJECT:asia-south1:INSTANCE (same as
# gcloud run deploy --add-cloudsql-instances).
#
# Do NOT commit live passwords. Put DATABASE_URL in Secret Manager.
# Founder must confirm instance name, tier, HA, backups/PITR, and billing
# before anyone creates a billed Cloud SQL instance — see docs/CLOUD_SQL_POSTGRES.md.
# -----------------------------------------------------------------------------
# DATABASE_URL=
# INSTANCE_CONNECTION_NAME=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=lumera
# SQL_HOST=127.0.0.1
# SQL_PORT=5432

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ALLOWED_ORIGINS: Comma-separated browser origins for CORS (no trailing slash).
# Production is fail-closed for unknown Origins and for missing Origin on
# mutating / API requests. Top-level SPA/HTML GET/HEAD (no Origin) is allowed.
# www↔apex companions are expanded automatically (www.mylumera.in ↔ mylumera.in).
# Meta / Razorpay webhook and /healthz stay exempt. If unset, APP_URL is used.
# Local:
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Production Cloud Run / Firebase (apex companion inferred from www if omitted):
# ALLOWED_ORIGINS="https://www.mylumera.in,https://mylumera.in"

# APP_URL: Public origin of this app (no trailing slash).
# Used for OAuth callbacks, policy links, data-deletion confirmation URLs,
# and self-referential URLs. Production Cloud Run MUST set:
#   APP_URL=https://www.mylumera.in
# otherwise POST /api/meta/data-deletion returns the Cloud Run host instead of www.
# Local:
APP_URL="http://localhost:3000"
# Cloud Run / Firebase production (www.mylumera.in) — set on the Cloud Run
# service (AI Studio secrets or gcloud), not in git:
# NODE_ENV=production
# APP_URL=https://www.mylumera.in
# JWT_SECRET=<long random value — required, no weak default>
# PORT is injected by Cloud Run; do not commit it.
# Meta / Facebook / Razorpay remain optional for the App Review URL hosting stage.

# Demo / SANDBOX logins (seeded, shared password Lumera@2026):
# admin@lumera.me            super_admin
# receptionist@lumera.me     receptionist, Individual (also reception@lumera.me)
# clinic.admin@lumera.me     CLINIC_ADMIN, Multi-specialty (opt-in demo only — register default stays Individual)
# patient@lumera.me          patient
# doctor@lumera.me           GP / Doctors & Clinics (Individual)
# cardiology@lumera.me       Cardiology
# dermatology@lumera.me      Dermatology
# orthopedics@lumera.me      Orthopedics
# pediatrics@lumera.me       Pediatrics
# gynecology@lumera.me       Gynecology
# ent@lumera.me              ENT
# ophthalmology@lumera.me    Ophthalmology
# dentist@lumera.me          Dental Surgery
# physio@lumera.me           Physiotherapy (session/assessment pack)
# therapist@lumera.me        Therapy / counseling (not Rx-first)
# wellness@lumera.me         Wellness & Spas / salon (not a medical chart)
# consultant@lumera.me       Consultant practice

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API + Facebook Login
# Live app credentials are OPTIONAL. Founder provisions the Meta / Facebook app
# separately — do not block local sandbox work (or merge) on App Review, Tech
# Provider, or Facebook Login credentials.
#
# Leave these commented in non-prod: simulators stay SANDBOX / DEV-ONLY.
# Values like replace-with-* are treated as unset (not live credentials).
# NODE_ENV=production without the required secrets hard-fails — no fake Graph
# wamid, no client-trusted OAuth email, no claimed Tech Provider certification.
# -----------------------------------------------------------------------------

# GET /api/meta/webhook hub.verify_token. Required in production (no hardcoded fallback).
# META_VERIFY_TOKEN=

# HMAC-SHA256 app secret for POST /api/meta/webhook X-Hub-Signature-256,
# POST /api/meta/data-deletion signed_request, and POST /api/meta/deauthorize signed_request.
# Required in production. Also used as Facebook app-secret fallback if FACEBOOK_APP_SECRET is unset.
# META_APP_SECRET=

# Non-prod: unsigned webhook POSTs are allowed when META_APP_SECRET is unset
# (credentials not provisioned yet). Set this to force unsigned ingest even when
# a secret is present. Ignored when NODE_ENV=production.
# META_WEBHOOK_ALLOW_UNSIGNED=true

# Graph API version for WhatsApp send and Facebook Login.
# META_GRAPH_API_VERSION=v21.0

# Graph send (OTP + Wave 2 reminders / book confirmations / payment receipts):
# POST https://graph.facebook.com/{version}/{phone-number-id}/messages
# Demo SQLite tokens containing "..." are ignored. Missing creds → SANDBOX SQLite
# path in non-prod; production returns a config error instead of faking delivery.
# Same dual-path for Platform reminder scheduler (#24) and WhatsApp receipt assist (#25).
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=

# Optional authentication template for OTP. If unset, Graph send uses a session text body.
# lumera_login_otp language code is "en" (not en_US). When META_OTP_TEMPLATE_NAME is set,
# Graph gets exactly one body text parameter (the OTP) and a COPY_CODE button stored as
# URL: type button, sub_type "url", index "0", parameters [{ type: "text", text: OTP }].
# Do not send clinic_name, a second body parameter, or a footer parameter (expiry is
# rendered by the template). Marketing coupons use sub_type copy_code / coupon_code and
# are not this path. Graph returns (#132018) if the AUTH button is sent as coupon_code,
# and (#131008) if the button parameter is omitted. META_OTP_TEMPLATE_BUTTON=true matches
# tip; the flag is not a gate.
# META_OTP_TEMPLATE_NAME=lumera_login_otp
# META_OTP_TEMPLATE_LANGUAGE=en
# META_OTP_TEMPLATE_BUTTON=true

# Optional Wave 2 utility templates. If unset, Graph send uses a session text body.
# Do not treat local SANDBOX template rows as Meta-approved.
# META_REMINDER_TEMPLATE_NAME=
# META_BOOK_CONFIRMATION_TEMPLATE_NAME=
# META_RECEIPT_TEMPLATE_NAME=
# META_UTILITY_TEMPLATE_LANGUAGE=en

# Aliases: WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET

# Appointment reminder scheduler (Wave 2 Platform) — same tenant-scoped appointments
# table as ClinicianApp. Queries Waiting/Confirmed rows at T−24h and T−2h (clinic
# timezone; default IST). Send uses server/graph-whatsapp.ts helpers from #28:
# sendAppointmentReminder, sendBookConfirmation, dispatchWhatsAppCloudMessage.
# APPOINTMENT_REMINDER_SCHEDULER=true
# APPOINTMENT_REMINDER_INTERVAL_MS=900000

# Facebook Login — OAuth 2.0 authorization code (confidential server).
# Founder: Meta App Review for Facebook Login (email, public_profile) is approved.
# This is NOT WhatsApp Tech Provider certification and does NOT auto-enable
# whatsapp_business_* scopes. Contact ravee@lumer.me.
#
# Cloud Run / production must set:
#   FACEBOOK_APP_ID=<numeric Meta app id>
#   FACEBOOK_APP_SECRET=<app secret>   (or META_APP_SECRET)
#   APP_URL=https://www.mylumera.in
# Meta App Dashboard → Facebook Login → Settings:
#   Client OAuth Login = Yes
#   Web OAuth Login = Yes
#   Enforce HTTPS = Yes
#   Use Strict Mode for Redirect URIs = Yes
#   Valid OAuth Redirect URIs (exact, no trailing slash):
#     https://www.mylumera.in/api/auth/facebook/callback
#   Site URL: https://www.mylumera.in/
#   App domains: www.mylumera.in
# Local:
#     http://localhost:3000/api/auth/facebook/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
# Aliases: FACEBOOK_CALLBACK_URL, META_APP_ID
#
# WhatsApp Embedded Signup v4 (Facebook Login for Business configuration).
# Create in Meta App Dashboard → Facebook Login for Business → Configurations
# using the WhatsApp Embedded Signup template. This is NOT Tech Provider
# certification. Handshake stays SANDBOX-honest until App Review is live.
# Contact ravee@lumer.me.
# META_EMBEDDED_SIGNUP_CONFIG_ID=
#
# Manual App Review flag for whatsapp_business_management / business_management /
# whatsapp_business_messaging. Default unset/false — do not set until Meta
# actually approved those scopes. Not auto-detected from Meta's dashboard.
# META_APP_REVIEW_WHATSAPP_SCOPES_APPROVED=false
#
# Rolling 7-day new-client onboarding cap: 10 before Meta business verification,
# 200 after. Unset = 10. Do not set unless Meta has fully verified the business.
# META_WHATSAPP_ONBOARDING_VERIFIED=false
#
# Non-prod without these: SANDBOX client-email OAuth remains (labeled DEV-ONLY).
# Production without these: Facebook Login returns 503; client-supplied emails are rejected.
#
# Optional dedicated HMAC for Facebook OAuth `state` JWTs. If unset, JWT_SECRET is
# required (same fail-closed rule as Lock PHI). There is no hardcoded fallback.
# FACEBOOK_OAUTH_STATE_SECRET=

# Google Sign-in (server-side authorization-code exchange)
# Create a Google Cloud Console OAuth 2.0 **Web application** client (not iOS/Android).
# The Firebase/AI Studio web client id in firebase-applet-config.json is NOT used
# for this server flow and has no client secret.
#
# Exact redirect URI the app sends (must match Console character-for-character):
#   Production (APP_URL=https://www.mylumera.in):
#     https://www.mylumera.in/api/auth/google/callback
#   Local:
#     http://localhost:3000/api/auth/google/callback
# Do not add a trailing slash. www and apex are different hosts — whitelist www
# (canonical). Optionally also add https://mylumera.in/api/auth/google/callback
# if the apex ever serves the app instead of 301ing to www.
#
# Authorized JavaScript origins (Console):
#   https://www.mylumera.in
#   https://mylumera.in          (optional; apex)
#   http://localhost:3000        (local only)
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override; default is {APP_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Aliases: GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_CALLBACK_URL
#
# Production without these: GET /api/auth/google returns 503; the Google button
# does not post a client-supplied email. Client-trusted Google email is disabled.
# Optional dedicated HMAC for Google OAuth `state` JWTs. If unset, JWT_SECRET is
# required. There is no hardcoded fallback.
# GOOGLE_OAUTH_STATE_SECRET=

# -----------------------------------------------------------------------------
# Razorpay UPI / payment-link collect (Wave 2 — issue #25)
# Platform lock: Razorpay only (Cashfree is out of scope).
# Live keys are OPTIONAL for local sandbox. Values like replace-with-* are
# treated as unset (same pattern as Meta #20).
#
# Leave these commented in non-prod: pay-order returns a SANDBOX / DEV-ONLY
# link; Paid status requires POST /api/invoices/:id/sandbox-pay (non-prod) or
# a verified Razorpay webhook.
# NODE_ENV=production without the required secrets hard-fails — no fake capture,
# no paid invoice without a verified webhook signature.
# This integration is not a PCI DSS certification and does not claim Razorpay
# partnership or a “certified” payment partner status.
# -----------------------------------------------------------------------------
# RAZORPAY_KEY_ID=replace-with-razorpay-key-id
# RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# -----------------------------------------------------------------------------
# Platform-to-tenant usage wallet (WhatsApp + AI Scribe) — not invoices, not SaaS
# Default markup is a 20% PLACEHOLDER until Super Admin sets usage_markup_config.
# META_BILL_SERVICE_WINDOW=true  → treat 24h service/utility replies as billed now
# META_FREE_SERVICE_WINDOW=true  → keep pre-Oct-2026 free window (tests / rollback)
# META_SERVICE_WINDOW_CUTOVER=2026-10-01T00:00:00.000Z
# -----------------------------------------------------------------------------
# META_BILL_SERVICE_WINDOW=
# META_FREE_SERVICE_WINDOW=
# META_SERVICE_WINDOW_CUTOVER=
# Optional INR cost per successful AI Scribe session (not a Gemini token or per-minute rate).
# Unset → usage_events.raw_cost stays null and the wallet is not debited.
# GEMINI_SCRIBE_RAW_COST_INR=

# -----------------------------------------------------------------------------
# ABDM / NHA sandbox (#35 freeze, #38 mode)
# Default stub = local stand-in, zero outbound. sandbox requires real creds
# (never commit them; never use SBX_LUMERA_* placeholders on the sandbox path).
# GET /api/abdm/status → { abdmMode, bridgeReady } only.
# -----------------------------------------------------------------------------
# ABDM_MODE=stub
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_GATEWAY_URL=https://sandbox.abdm.gov.in/api/v3
# Optional HMAC for public HIP/HIU callbacks (X-ABDM-Signature: sha256=…).
# Unset = sandbox-tolerant unsigned ingest on the stub path. Never commit the secret.
# ABDM_CALLBACK_SECRET=
# Freeze HIP/HIU paths (#35). Aliases /hip/data-notification → on-request.
#   {APP_URL}/api/abdm/hip/link/care-context
#   {APP_URL}/api/abdm/hip/patient-discover
#   {APP_URL}/api/abdm/hip/link/on-confirm
#   {APP_URL}/api/abdm/hip/consent/on-notify
#   {APP_URL}/api/abdm/hip/health-information/on-request
#   {APP_URL}/api/abdm/hiu/consent-request/init
#   {APP_URL}/api/abdm/hiu/consent-request/on-status
#   {APP_URL}/api/abdm/hiu/health-information/request
#   {APP_URL}/api/abdm/hiu/health-information/on-receive
#   {APP_URL}/api/abdm/hiu/consents?patientId=

# -----------------------------------------------------------------------------
# Error tracking — GCP Error Reporting (Cloud Run). No Sentry.
# Lumera is not a certified Meta Tech Provider. Contact ravee@lumer.me.
#
# Unset on Cloud Run: the process reports structured Error Reporting events
# via Cloud Logging (K_SERVICE / metadata server). Local/tests log
# "error tracker: console fallback" and must not crash.
#
# Production placeholders (replace-with-*, change-me) or a Sentry DSN URL
# fail boot instead of silently no-op.
# ERROR_REPORTING=          # unset | gcp | console
# ERROR_REPORTING_PROJECT_ID=
# SENTRY_DSN must stay unset (not used).
# -----------------------------------------------------------------------------