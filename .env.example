# JWT_SECRET: Required. Auth fails closed if this is unset — there is no
# hardcoded fallback. Use a long random value in every environment.
JWT_SECRET="change-me-to-a-long-random-secret"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin of this app (no trailing slash).
# Used for OAuth callbacks, policy links, and self-referential URLs.
APP_URL="http://localhost:3000"

# Demo logins (seeded on first SQLite start, password Lumera@2026):
# admin@lumera.me  super_admin
# doctor@lumera.me doctor
# patient@lumera.me patient
# reception@lumera.me receptionist

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API / webhooks
# -----------------------------------------------------------------------------
# GET /api/meta/webhook hub.verify_token. Required in production (no hardcoded fallback).
META_VERIFY_TOKEN="replace-with-meta-webhook-verify-token"

# App secret used to verify POST /api/meta/webhook X-Hub-Signature-256 (HMAC-SHA256).
# Required in production. Also used as Facebook app-secret fallback if FACEBOOK_APP_SECRET is unset.
META_APP_SECRET="replace-with-meta-app-secret"

# Non-prod ONLY: accept unsigned webhook POSTs when this is true/1.
# Ignored when NODE_ENV=production (signatures are always required).
META_WEBHOOK_ALLOW_UNSIGNED="false"

# Graph API version for WhatsApp send and Facebook Login.
META_GRAPH_API_VERSION="v21.0"

# Permanent / system-user token + phone number id for Graph OTP send
# POST https://graph.facebook.com/{version}/{phone-number-id}/messages
# Demo SQLite tokens containing "..." are ignored. In production, missing creds return a config error
# instead of faking delivery.
META_ACCESS_TOKEN="replace-with-graph-access-token"
META_PHONE_NUMBER_ID="replace-with-numeric-phone-number-id"

# Optional authentication/utility template for OTP. If unset, Graph send uses a session text body.
# META_OTP_TEMPLATE_NAME="lumera_login_otp"
# META_OTP_TEMPLATE_LANGUAGE="en"

# Aliases accepted by the server:
# WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET

# -----------------------------------------------------------------------------
# Facebook Login (server-side token exchange) — issue #16
# -----------------------------------------------------------------------------
# Create a Facebook Login product on the same Meta app. Valid OAuth Redirect URIs must include:
#   {APP_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID="replace-with-facebook-app-id"
FACEBOOK_APP_SECRET="replace-with-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"
# FACEBOOK_CALLBACK_URL is accepted as an alias of FACEBOOK_REDIRECT_URI.
# META_APP_ID is accepted as an alias of FACEBOOK_APP_ID.

# Production: POST /api/auth/oauth rejects client-supplied profile.email.
# Happy path: GET /api/auth/facebook → Facebook dialog → GET /api/auth/facebook/callback
# (code exchange + debug_token app-id check + Graph /me). Session is minted only for an
# existing user whose email matches the verified Facebook email.
# Unregistered verified emails are redirected to clinic registration (no auto-provision).
